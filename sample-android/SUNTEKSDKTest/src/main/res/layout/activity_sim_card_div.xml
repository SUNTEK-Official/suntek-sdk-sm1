<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="选择SIM卡:"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/sim_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/pin_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="当前状态: 未知"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/current_pin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="当前PIN码"
        android:inputType="numberPassword"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/new_pin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="新PIN码"
        android:inputType="numberPassword"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/confirm_pin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="确认新PIN码"
        android:inputType="numberPassword"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <Button
            android:id="@+id/enable_pin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="启用"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/disable_pin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="禁用"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/change_pin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="修改"/>
    </LinearLayout>
</LinearLayout>